@* Emitted markup is a version contract — see Components/CLAUDE.md.

   @attributes comes FIRST and the computed class LAST, so a stray class="…" from
   the call site cannot wipe .nav-link. Add classes through Class. *@

<a @attributes="AdditionalAttributes"
   class="@CssClass"
   href="@Href"
   aria-current="@AriaCurrent"
   data-tip="@Tip"
   target="@Target"
   rel="@Rel">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <i class="@Icon"></i>
    }
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <span>@Label</span>
    }
    @if (Count is not null)
    {
        <span class="nav-count">@Count</span>
    }
    @if (External)
    {
        <i class="ri-external-link-line nav-link-ext"></i>
    }
</a>
