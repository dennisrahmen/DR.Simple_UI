@* Emitted markup is a version contract — see Components/CLAUDE.md. *@

<aside @attributes="AdditionalAttributes" class="@SidebarCssClass">
    @if (Brand is not null)
    {
        @Brand
    }
    else if (!string.IsNullOrWhiteSpace(Title))
    {
        @* An <a> when there is somewhere to go, a <div> when there is not: a link
           with no href is not reachable by keyboard and is announced as a link
           anyway. *@
        @if (BrandHref is not null)
        {
            <a class="brand" href="@BrandHref">@BrandInner</a>
        }
        else
        {
            <div class="brand">@BrandInner</div>
        }
    }

    <nav class="nav">
        <div class="nav-scroll">
            @ChildContent
        </div>
        @if (Tools is not null)
        {
            <div class="nav-tools">@Tools</div>
        }
    </nav>
</aside>

@code {
    private RenderFragment BrandInner => @<text>
        @if (!string.IsNullOrWhiteSpace(LogoSrc))
        {
            <img class="brand-logo" src="@LogoSrc" width="30" height="30" alt="" />
        }
        <span class="brand-text">
            <strong>@Title</strong>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <span class="brand-sub">@Subtitle</span>
            }
        </span>
    </text>;
}
