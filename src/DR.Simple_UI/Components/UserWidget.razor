@* Emitted markup is a version contract — see Components/CLAUDE.md. *@

<div @attributes="AdditionalAttributes" class="@CssClass" @onkeydown="HandleKeyDown">
    @if (Menu is not null)
    {
        @* A disclosure, not a role="menu": the items are ordinary links and
           buttons that tab normally. Declaring role="menu" would promise arrow-key
           navigation and a roving tabindex, and a menu that claims that without
           implementing it is worse than one that claims nothing. *@
        <button class="user-trigger" type="button"
                aria-expanded="@(_open ? "true" : "false")"
                @onclick="Toggle">
            @Identity
        </button>
    }
    else
    {
        <div class="user-trigger">@Identity</div>
    }

    @if (!string.IsNullOrWhiteSpace(SignOutHref))
    {
        <a class="user-signout" href="@SignOutHref" aria-label="@SignOutLabel" data-tip="@SignOutTip">
            <i class="ri-logout-box-r-line"></i>
        </a>
    }

    @if (Menu is not null && _open)
    {
        @* The panel is the library's one dropdown style, .menu; only its anchoring
           is the frame's, and that lives in 15-frame-user-widget.css. *@
        <div class="menu-scrim" @onclick="Close"></div>
        <div class="menu">@Menu</div>
    }
</div>

@code {
    private RenderFragment Identity => @<text>
        <span class="user-avatar">
            @if (Avatar is not null)
            {
                @Avatar
            }
            else if (!string.IsNullOrWhiteSpace(AvatarSrc))
            {
                <img src="@AvatarSrc" width="28" height="28" alt="" />
            }
            else if (!string.IsNullOrWhiteSpace(Initials))
            {
                <span>@Initials</span>
            }
            else
            {
                <i class="ri-user-line"></i>
            }
        </span>
        @if (!string.IsNullOrWhiteSpace(Name) || !string.IsNullOrWhiteSpace(Secondary))
        {
            <span class="user-info">
                <span class="user-name">@Name</span>
                @if (!string.IsNullOrWhiteSpace(Secondary))
                {
                    <span class="user-email">@Secondary</span>
                }
            </span>
        }
    </text>;
}
