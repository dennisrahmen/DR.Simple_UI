@page "/"
@rendermode InteractiveServer

<PageTitle>APP_TITLE</PageTitle>

@* Page content is CSS classes on plain markup — there is no <Card> or <DataTable>
   component and there will not be one. Copy from the catalogue. *@
<div class="page-head">
    <div class="page-head-text">
        <h1>Home</h1>
        <p>Replace this with the page that matters.</p>
    </div>
    <div class="page-head-actions">
        <button class="btn" type="button" @onclick="Refresh">
            <i class="ri-refresh-line"></i> Refresh
        </button>
        <button class="btn btn-primary" type="button" @onclick="Confirm">
            <i class="ri-check-line"></i> Do the thing
        </button>
    </div>
</div>

<div class="stat-row">
    <div class="stat">
        <span class="stat-label">Open</span>
        <span class="stat-value">@_open</span>
    </div>
    <div class="stat">
        <span class="stat-label">Resolved today</span>
        <span class="stat-value">143</span>
        <span class="stat-delta stat-delta--good"><i class="ri-arrow-up-line"></i> 18%</span>
    </div>
</div>

<div class="card" style="margin-top:16px">
    <div class="card-head"><strong>Recent</strong></div>
    <table class="table">
        <thead>
            <tr><th>Item</th><th>State</th><th class="col-num">Age</th></tr>
        </thead>
        <tbody>
            <tr><td>INC0031209</td><td><span class="badge badge-warn">Pending</span></td><td class="col-num">4</td></tr>
            <tr><td>INC0031204</td><td><span class="badge badge-go">Approved</span></td><td class="col-num">22</td></tr>
        </tbody>
    </table>
</div>

@code {
    private int _open = 77;

    [Inject] private IJSRuntime Js { get; set; } = default!;

    // The library's JS is called through IJSRuntime like any other interop; it never
    // calls back into .NET.
    private async Task Refresh()
    {
        _open++;
        await Js.InvokeVoidAsync("drSimpleUi.toast", "Refreshed", new { kind = "go" });
    }

    private async Task Confirm()
    {
        var ok = await Js.InvokeAsync<bool>("drSimpleUi.confirm", new
        {
            title = "Do the thing?",
            message = "This is what the confirmation dialog looks like.",
            confirm = "Do it"
        });

        await Js.InvokeVoidAsync("drSimpleUi.toast",
            ok ? "Done" : "Cancelled", new { kind = ok ? "go" : "info" });
    }
}
