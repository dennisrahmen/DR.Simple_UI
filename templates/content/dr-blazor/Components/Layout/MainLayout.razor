@inherits LayoutComponentBase

@* The whole shell. Note what is NOT here: no widths, no colours, no local overrides.
   The frame must look identical in every app, so if something about it is wrong it is
   wrong in the library — report it there rather than patching it here.

   <ChildContent> is written out explicitly, and it is not optional: as soon as a
   component has ONE named RenderFragment parameter, Razor stops accepting loose child
   content and fails with RZ9996. AppShell has Navigation and Header, Sidebar has
   Tools, AppHeader has Start — so all three need it. *@
<AppShell Class="@(_responsive ? "layout--responsive" : null)">

    <Navigation>
        <Sidebar Title="APP_TITLE" Subtitle="Netpoint" BrandHref="/" Collapsed="@_railed">
            <ChildContent>
                @* Href="" is the app root and needs Match="All". With the default
                   Prefix it matches every address and stays active on every page. *@
                <NavItem Href="" Match="NavLinkMatch.All" Icon="ri-home-4-line" Label="Home"
                         Tip="The dashboard." />
                <NavItem Href="queue" Icon="ri-inbox-line" Label="Queue" Count="@_pending"
                         Tip="Items waiting on a decision." />
            </ChildContent>
            <Tools>
                <NavItem Href="https://github.dennisrahmen.de/" Icon="ri-book-2-line"
                         Label="UI catalogue" Tool External />
            </Tools>
        </Sidebar>
    </Navigation>

    <Header>
        <AppHeader>
            <Start>
                @* The library has no opinion on where this lives, so the app owns it.
                   Below 900px .layout--responsive forces the rail and this becomes a
                   no-op — hide it at that width if that bothers you. *@
                <button class="topbar-btn topbar-btn--start" type="button"
                        aria-label="@(_railed ? "Expand navigation" : "Collapse navigation")"
                        data-tip="Collapse the sidebar to an icon rail."
                        @onclick="() => _railed = !_railed">
                    <i class="ri-side-bar-line"></i>
                </button>
            </Start>
            <ChildContent>
                @* Bound to fields rather than written inline: an e-mail address in a
                   Razor attribute is read as a C# expression at the @, which fails with
                   RZ9986. In a real app these come from the authentication state
                   anyway. *@
                <UserWidget Name="@_userName" Secondary="@_userEmail" Initials="@_userInitials">
                    <Menu>
                        <a class="menu-item" href="/preferences">
                            <i class="ri-settings-3-line"></i> Preferences
                        </a>
                        <hr class="menu-sep" />
                        <a class="menu-item menu-item--danger" href="/signout">
                            <i class="ri-logout-box-r-line"></i> Sign out
                        </a>
                    </Menu>
                </UserWidget>
            </ChildContent>
        </AppHeader>
    </Header>

    <ChildContent>
        @* tabindex="-1" is what makes the skip link move focus. Without it the browser
           scrolls and focus stays in the navigation, which is the bug the skip link
           existed to fix. *@
        <main id="main" tabindex="-1">
            @Body
        </main>
    </ChildContent>
</AppShell>

@code {
    private bool _railed;
    private bool _responsive = true;
    private int? _pending = 3;

    private string _userName = "Dennis Rahmen";
    private string _userEmail = "rahmen@netpoint.de";
    private string _userInitials = "DR";
}
